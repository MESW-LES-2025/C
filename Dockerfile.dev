# ===== Development Dockerfile with Hot Reload =====

# ===== Frontend Development =====
FROM node:20 AS build-frontend-dev
WORKDIR /app
# Dependencies will be installed via volume mount and command in docker-compose
EXPOSE 4200

# ===== Backend Development with Hot Reload =====
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build-backend-dev
WORKDIR /src

# Install dotnet tools
RUN dotnet tool install --global dotnet-ef
ENV PATH="${PATH}:/root/.dotnet/tools"

# Copy project files for dependency restoration
COPY C.sln .
COPY src/Consilium.API/Consilium.API.csproj src/Consilium.API/
COPY src/Consilium.Application/Consilium.Application.csproj src/Consilium.Application/
COPY src/Consilium.Domain/Consilium.Domain.csproj src/Consilium.Domain/
COPY src/Consilium.Infrastructure/Consilium.Infrastructure.csproj src/Consilium.Infrastructure/

# Restore dependencies
RUN dotnet restore C.sln

EXPOSE 8080

# Use dotnet watch for hot reload
# Source code will be mounted as a volume in docker-compose
WORKDIR /src/src/Consilium.API
ENTRYPOINT ["dotnet", "watch", "run", "--non-interactive", "--urls", "http://+:8080"]
